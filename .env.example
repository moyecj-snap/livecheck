# Live Stripe + Coinbase settlement. Leave unset to boot in mock/dev mode.
# x402 stablecoin payments are unavailable to NY businesses. Builder is in California.

# Stripe secret key (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=

# Base deposit address from:
#   curl https://api.stripe.com/v1/crypto/deposit_addresses \
#     -u "$STRIPE_SECRET_KEY:" \
#     -H "Stripe-Version: 2026-05-27.preview" \
#     -d network=base
DEPOSIT_ADDRESS=

# Coinbase Developer Platform API keys (facilitator on Base mainnet)
# https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional. Defaults to 43127.
PORT=43127

# Optional. Cursor MCP only (src/mcp.ts). Full verify URL, not a secret.
# LIVECHECK_URL=http://127.0.0.1:43127/v1/verify

# Optional public origin advertised on 402 resource.url (not a secret).
# Local default is the request origin (http://127.0.0.1:43127).
# Production must be https://livecheck.fly.dev (Fly sets this in fly.toml [env]).
# LIVECHECK_PUBLIC_URL=https://livecheck.fly.dev

# Optional. SQLite path for privacy-safe paid_call retention (CoS L7d/L30d).
# Fly volume default is /data/paid-calls.sqlite (fly.toml [env] + [[mounts]]).
# Local default is ./data/paid-calls.sqlite. Not a secret.
# PAID_CALL_DB_PATH=./data/paid-calls.sqlite

# Optional. SQLite path for Sentinel watchers + callback events.
# Fly volume default is /data/watchers.sqlite (fly.toml [env] + [[mounts]]).
# Local default is ./data/watchers.sqlite. Not a secret. Same volume as paid_calls.
# No Postgres in this phase — migrate later by dumping the watchers table.
# WATCH_DB_PATH=./data/watchers.sqlite

# Optional. Ed25519 private key for Confirm receipts (PKCS#8 PEM recommended).
# Also accepts a 32-byte seed as hex (64 chars) or base64.
# Generate PEM:
#   node --input-type=module -e "import { generateKeyPairSync } from 'node:crypto'; process.stdout.write(generateKeyPairSync('ed25519').privateKey.export({ type: 'pkcs8', format: 'pem' }).toString())"
# Unset: Confirm still returns id + unsigned receipt stub (hash + verify_url). Paid path does not crash.
# CONFIRM_RECEIPT_PRIVATE_KEY=

# Optional. eBay Browse availability for /itm/{id} URLs (not sold/completed prices).
# App ID + Cert ID from developer.ebay.com. Server boots without them.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_DEV_ID=
# EBAY_MARKETPLACE_ID=EBAY_US
