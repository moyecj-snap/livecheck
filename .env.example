# Live Stripe + Coinbase settlement. Leave unset to boot in mock/dev mode.
# x402 stablecoin payments are unavailable to NY businesses. Builder is in California.

# Stripe secret key (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=

# Base deposit address from:
#   curl https://api.stripe.com/v1/crypto/deposit_addresses \
#     -u "$STRIPE_SECRET_KEY:" \
#     -H "Stripe-Version: 2026-05-27.preview" \
#     -d network=base
DEPOSIT_ADDRESS=

# Coinbase Developer Platform API keys (facilitator on Base mainnet)
# https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional. Defaults to 43127.
PORT=43127
